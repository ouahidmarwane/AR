# Copier ce fichier en apps/web/.env.local et le compléter. Ne JAMAIS commiter de vraie valeur.
# PUBLIC  = préfixe NEXT_PUBLIC_, exposée au navigateur (aucun secret).
# SERVEUR = lue uniquement côté serveur (Server Actions, Route Handlers, scripts). Secret.
# DOCKER  = lue uniquement par docker compose pour créer la base MySQL locale.

# --- Base de données (MySQL 8 + Drizzle) ---
# SERVEUR : URL de connexion MySQL utilisée par l'app, drizzle-kit et les scripts.
DATABASE_URL=mysql://ar_user:ar_password@localhost:3306/ar_menu
# SERVEUR : nombre max de connexions du pool (garder bas sur un hébergement mutualisé).
DB_CONNECTION_LIMIT=5
# DOCKER : mot de passe root du MySQL local (vide = "root" par défaut, en local uniquement).
MYSQL_ROOT_PASSWORD=
# DOCKER : nom de la base créée au premier démarrage (une base "<nom>_test" est aussi créée pour les tests).
MYSQL_DATABASE=ar_menu
# DOCKER : utilisateur applicatif créé au premier démarrage (doit correspondre à DATABASE_URL).
MYSQL_USER=ar_user
# DOCKER : mot de passe de l'utilisateur applicatif (doit correspondre à DATABASE_URL).
MYSQL_PASSWORD=ar_password

# --- Authentification (Better Auth) ---
# SERVEUR : secret de signature des sessions, 32 caractères min. (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# SERVEUR : URL publique de l'app, utilisée par Better Auth pour les callbacks et les cookies.
BETTER_AUTH_URL=http://localhost:3000
# PUBLIC : URL publique de l'app (liens absolus, QR codes).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stockage des fichiers ---
# SERVEUR : pilote de stockage (local = disque du serveur ; r2 = stockage objet S3, à venir).
STORAGE_DRIVER=local
# SERVEUR : dossier des fichiers pour le pilote local, relatif à apps/web (hors du dossier de l'app).
STORAGE_LOCAL_PATH=../../storage

# --- IA (import de menu) ---
# SERVEUR : clé de l'API Claude (Anthropic) pour l'import de menu par IA.
ANTHROPIC_API_KEY=
# SERVEUR : identifiant du modèle Claude utilisé pour l'extraction des menus.
CLAUDE_MENU_MODEL=claude-sonnet-5-5

# --- Paiement ---
# SERVEUR : fournisseur de paiement actif (manual = abonnements gérés à la main).
PAYMENT_PROVIDER=manual
# SERVEUR : clé secrète de l'API du fournisseur de paiement.
PAYMENT_SECRET_KEY=
# SERVEUR : secret de vérification de signature des webhooks de paiement.
PAYMENT_WEBHOOK_SECRET=

# --- Génération 3D (worker GPU TRELLIS.2, phase 5) ---
# SERVEUR : URL du worker GPU qui génère les modèles 3D.
GPU_ENDPOINT_URL=
# SERVEUR : clé d'authentification des appels vers le worker GPU.
GPU_API_KEY=
# SERVEUR : secret de vérification de signature des webhooks renvoyés par le worker GPU.
GPU_WEBHOOK_SECRET=

# --- E-mail ---
# SERVEUR : pilote d'envoi (console = affiche les liens dans les logs, local uniquement ; resend = à venir).
EMAIL_DRIVER=console
# SERVEUR : expéditeur des e-mails transactionnels.
EMAIL_FROM=AR Menu <no-reply@localhost>
# SERVEUR : clé de l'API Resend pour les e-mails transactionnels.
RESEND_API_KEY=

# --- Observabilité ---
# SERVEUR : DSN Sentry pour le suivi des erreurs (optionnel en local).
SENTRY_DSN=
