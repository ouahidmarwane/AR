{
  "name": "ar",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS de menus de restaurant avec réalité augmentée",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @ar/web dev",
    "build": "pnpm --filter @ar/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "echo \"No tests yet\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ar/config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.3.0"
  }
}
