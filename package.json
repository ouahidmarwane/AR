{
  "name": "ar",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS de menus de restaurant avec réalité augmentée",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @ar/web dev",
    "build": "pnpm --filter @ar/web build",
    "build:hostinger": "pnpm --filter @ar/web build:hostinger",
    "start": "pnpm --filter @ar/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @ar/web test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file apps/web/.env.local up -d --wait",
    "db:down": "docker compose --env-file apps/web/.env.local down",
    "db:generate": "pnpm --filter @ar/web db:generate",
    "db:migrate": "pnpm --filter @ar/web db:migrate",
    "db:seed": "pnpm --filter @ar/web db:seed",
    "db:studio": "pnpm --filter @ar/web db:studio",
    "db:reset": "pnpm --filter @ar/web db:reset && pnpm db:migrate && pnpm db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ar/config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
